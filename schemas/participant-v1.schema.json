{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional CORE participant metadata — no account or authentication service",
  "type": "object", "additionalProperties": false,
  "required": ["pseudonym", "interests", "expertise", "progressionEnabled"],
  "properties": {
    "pseudonym": {"type": "string", "minLength": 2, "maxLength": 48},
    "avatar": {"type": "object", "additionalProperties": false, "required": ["shape", "color", "textAlternative"], "properties": {
      "shape": {"enum": ["circle", "square", "hexagon"]},
      "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
      "textAlternative": {"type": "string", "minLength": 1, "maxLength": 120}
    }},
    "interests": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 60}},
    "expertise": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 60}},
    "progressionEnabled": {"type": "boolean"}
  }
}
