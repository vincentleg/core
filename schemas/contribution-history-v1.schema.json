{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private contribution audit events — never export private content hashes publicly",
  "type": "array", "maxItems": 256,
  "items": {
    "type": "object", "additionalProperties": false,
    "required": ["sequence", "at", "actor", "from", "to", "revision", "contentHash", "detail", "prev", "hash"],
    "properties": {
      "sequence": {"type": "integer", "minimum": 1, "maximum": 256},
      "at": {"type": "string", "format": "date-time"},
      "actor": {"enum": ["demo.participant", "demo.moderator", "demo.reviewer", "demo.simulator", "demo.publisher"]},
      "from": {"enum": [null, "DRAFT", "SUBMITTED", "SCREENED", "UNDER_REVIEW", "EVIDENCE_ASSESSED", "SIMULATED", "REVISED", "APPROVED_FOR_PUBLICATION", "PUBLISHED", "REJECTED_OR_WITHDRAWN"]},
      "to": {"enum": ["DRAFT", "SUBMITTED", "SCREENED", "UNDER_REVIEW", "EVIDENCE_ASSESSED", "SIMULATED", "REVISED", "APPROVED_FOR_PUBLICATION", "PUBLISHED", "CONSIDERED_BY_PARTNER", "AUTHORIZED_FOR_PILOT", "PILOT_RUNNING", "IMPLEMENTED", "IMPACT_MEASURED", "REJECTED_OR_WITHDRAWN"]},
      "revision": {"type": "integer", "minimum": 1, "maximum": 32},
      "contentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "detail": {"type": "object", "additionalProperties": false, "properties": {
        "questionId": {"type": "string", "pattern": "^[a-z0-9-]{2,60}$"},
        "researchFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "note": {"type": "string", "maxLength": 600},
        "objection": {"enum": ["TESTIMONY_NOT_CORROBORATED", "UNCALIBRATED", "FEASIBILITY_UNKNOWN"]},
        "projectionDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidence": {"type": "array", "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["id", "hash"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9-]{2,60}$"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
      }},
      "prev": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }
  }
}
