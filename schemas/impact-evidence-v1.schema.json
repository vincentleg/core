{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Typed contribution evidence; type is not verification or real-world authority",
  "type": "object", "additionalProperties": false,
  "required": ["id", "kind", "source", "observedAt", "retrievedAt", "payloadSha256", "license", "uncertainty", "payload"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]{2,60}$"},
    "kind": {"enum": ["SYNTHETIC_TESTIMONY", "SYNTHETIC_COUNTS", "OBSERVATION", "SIMULATION", "PARTNER_CONSIDERATION", "PILOT_AUTHORIZATION", "DEPLOYMENT", "INDEPENDENT_IMPACT"]},
    "source": {"type": "string", "minLength": 1, "maxLength": 250},
    "observedAt": {"type": "string", "format": "date-time"},
    "retrievedAt": {"type": "string", "format": "date-time"},
    "payloadSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "license": {"const": "DEMO_ONLY_NO_COMMERCIAL_GRANT"},
    "uncertainty": {"type": "string", "minLength": 1, "maxLength": 600},
    "payload": {"type": "object"}
  }
}
