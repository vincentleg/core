{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CORE contribution revision — private by default, synthetic sandbox only at runtime",
  "type": "object", "additionalProperties": false,
  "required": ["mode", "observation", "interpretation", "proposal", "privateContext", "location", "consent", "evidenceRefs", "relations"],
  "properties": {
    "mode": {"const": "synthetic-demo"},
    "observation": {"type": "object", "additionalProperties": false, "required": ["statement", "at", "epistemic", "uncertainty"], "properties": {
      "statement": {"type": "string", "minLength": 1, "maxLength": 1200},
      "at": {"type": "string", "format": "date-time"},
      "epistemic": {"const": "synthetic-testimony"},
      "uncertainty": {"type": "string", "minLength": 1, "maxLength": 600}
    }},
    "interpretation": {"type": "string", "minLength": 1, "maxLength": 1200},
    "proposal": {"type": "string", "minLength": 1, "maxLength": 1200},
    "privateContext": {"type": "string", "maxLength": 1200},
    "location": {"type": "object", "additionalProperties": false, "required": ["city", "neighborhood"], "properties": {
      "city": {"type": "string", "minLength": 1, "maxLength": 40},
      "neighborhood": {"type": "string", "minLength": 1, "maxLength": 80},
      "privatePoint": {"type": "object", "additionalProperties": false, "required": ["lat", "lon"], "properties": {"lat": {"type": "number", "minimum": -90, "maximum": 90}, "lon": {"type": "number", "minimum": -180, "maximum": 180}}}
    }},
    "consent": {"type": "object", "additionalProperties": false, "required": ["publication", "pseudonym", "approximateLocation", "avatar", "interests", "expertise", "thirdPartyProtected"], "properties": {
      "publication": {"type": "boolean"}, "pseudonym": {"type": "boolean"}, "approximateLocation": {"type": "boolean"}, "avatar": {"type": "boolean"}, "interests": {"type": "boolean"}, "expertise": {"type": "boolean"}, "thirdPartyProtected": {"const": true}
    }},
    "evidenceRefs": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]{2,60}$"}},
    "relations": {"type": "object", "additionalProperties": false, "required": ["problems", "reuses", "supersedes"], "properties": {
      "problems": {"type": "array", "maxItems": 8, "items": {"type": "string", "pattern": "^[a-z0-9-]{2,60}$"}},
      "reuses": {"type": "array", "maxItems": 8, "items": {"type": "string", "pattern": "^contribution-[a-z0-9-]{1,50}$"}},
      "supersedes": {"type": "array", "maxItems": 8, "items": {"type": "string", "pattern": "^contribution-[a-z0-9-]{1,50}$"}}
    }}
  }
}
